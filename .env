APP_ENV=development
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=60
GMAIL_POLLING_ENABLED=false
GMAIL_USER_ID=me
GMAIL_QUERY=in:anywhere -in:spam -in:trash newer_than:7d
GMAIL_MAX_RESULTS=25
GMAIL_CREDENTIALS_FILE=/run/secrets/gmail_credentials.json
GMAIL_TOKEN_FILE=/run/secrets/gmail_token.json
POSTGRES_DB=company_automation
POSTGRES_USER=automation
POSTGRES_PASSWORD= 
DATABASE_URL=postgresql+psycopg://automation:password@localhost:5433/company_automation
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=invoice-extractor
OLLAMA_TIMEOUT_SECONDS=180
GEMINI_API_KEY= 
GEMINI_MODEL= gemini-3.5-flash-lite
HR_REVIEW_EMAIL=
HR_NOTIFICATION_ENABLED=false
PROMETHEUS_PORT=8000
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=