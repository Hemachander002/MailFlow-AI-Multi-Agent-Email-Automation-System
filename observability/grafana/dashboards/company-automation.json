          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n    hr.job_id AS \"Job ID\",\r\n    candidate.email_id AS \"Candidate Email ID\",\r\n    hr.skills_score AS \"Skills Score\",\r\n    hr.project_score AS \"Project Score\",\r\n    hr.created_at AS \"Applied At\"\r\nFROM hr\r\nJOIN candidate\r\n    ON candidate.candidate_id = hr.candidate_id\r\nWHERE\r\n    '${job_id:raw}' = '%'\r\n    OR hr.job_id = '${job_id:raw}'\r\nORDER BY hr.created_at DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
